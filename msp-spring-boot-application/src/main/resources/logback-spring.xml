<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <define name="HOSTNAME" class="ch.qos.logback.core.property.CanonicalHostNamePropertyDefiner" scope="context"/>

  <springProperty name="appName" source="spring.application.name" defaultValue="app"/>
  <contextName>${appName}</contextName>

  <springProfile name="local">
    <appender name="console-appender" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="console-appender"/>
    </root>
  </springProfile>

  <springProfile name="!local">
    <appender name="json-appender" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>
    <appender name="otel-appender" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender"/>

    <root level="INFO">
      <appender-ref ref="json-appender"/>
      <appender-ref ref="otel-appender"/>
    </root>
  </springProfile>
</configuration>
